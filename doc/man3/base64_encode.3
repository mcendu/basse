#include <base64.h>
#include <stdio.h>
#include <string.h>

int main(void)
{
    static const char in[] = "hello, world";
    char buf[32];

    base64_encode(in, strlen(in), buf, sizeof(buf));
    printf("%s\en", buf);
    return 0;
}
.Ed
.Pp
When compiled and run, produces the following output:
.Bd -literal -offset indent
$ ./a.out
aGVsbG8sIHdvcmxk
