#include <base64.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void)
{
    static const char in[] = "aGVsbG8sIHdvcmxkCg==";
    char buf[16];

    struct base64_decoder *dec = malloc(base64_decoder_size());
    if (!dec) return 1;
    base64_decoder_init(dec);

    size_t outlen = sizeof(buf);
    base64_decode(dec, in, strlen(in), buf, &outlen);
    printf("%.*s", (int)outlen, buf);

    free(dec);
    return 0;
}
.Ed
.Pp
Note the format string passed to
.Xr printf 3 ;
unlike
.Xr base64_encode 3 ,
the
.Fn base64_decode
function does not attempt to null
.Ql ( \e0 )
terminate its output, so explicitly specifying the length is necessary.
.Pp
The following example allocates the decoder object statically; a C11
compiler, like
.Xr gcc 1
4.7 or later, is required to compile this example.
.Bd -literal -offset indent
